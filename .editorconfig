# O básico para qualquer editor contribuir sem sujeira de diff (espaço, final de linha, charset).
# Estilo de código continua sob as regras do CLAUDE.md; isto só padroniza o arquivo em si.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
