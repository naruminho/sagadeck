{
  "name": "sagadeck",
  "version": "1.7.0",
  "description": "Gerador de apresentações: YAML -> HTML animado + PowerPoint editável, com temas e figuras geradas na hora.",
  "type": "module",
  "bin": {
    "sagadeck": "bin/sagadeck.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "jszip": "^3.10.2",
    "katex": "^0.18.9",
    "lucide-static": "^1.47.0",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "^1.63.0",
    "plotly.js-dist-min": "^4.1.1",
    "pptxgenjs": "^4.0.1",
    "qrcode-generator": "^2.0.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@material-symbols/svg-400": "^0.47.5",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "mermaid": "^11.17.2"
  },
  "scripts": {
    "dev": "node bin/sagadeck.js studio",
    "build:code-lab": "node scripts/bundle-code-lab.mjs",
    "test:live": "node tools/test-live.mjs",
    "test": "node --import ./test/isolate.js --test --test-concurrency=1 \"test/*.test.js\"",
    "test:unit": "node --import ./test/isolate.js --test test/engine.test.js",
    "test:ui": "node --import ./test/isolate.js --test --test-concurrency=1 test/runtime.test.js test/studio.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/naruminho/sagadeck"
  },
  "author": "Narumi Abe",
  "files": [
    "bin",
    "src",
    "templates",
    "docs",
    "SKILL.md"
  ]
}
